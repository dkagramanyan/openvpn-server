# Copy to .env and adjust. Never commit .env.

# Web UI admin account (created on first start only; change it later in the UI).
OPENVPN_ADMIN_USERNAME=admin
# Leave empty to have a random password generated and printed in the UI logs
# (docker compose logs openvpn-ui).
OPENVPN_ADMIN_PASSWORD=

# Public address of this server, written into every client profile as
# "remote <host> <port> <proto>". Can also be changed later in Settings.
# The containers use host networking, so the port and protocol have to match
# "port" and "proto" in server.conf - that is what OpenVPN binds on the host.
OVPN_PUBLIC_HOST=vpn.example.com
OVPN_PUBLIC_PORT=1195
OVPN_PUBLIC_PROTO=tcp

# Set to "true" when the UI is served through an HTTPS reverse proxy.
OVPN_UI_SECURE_COOKIES=auto

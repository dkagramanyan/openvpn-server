# Copy to .env and adjust. Never commit .env.

# Web UI admin account (created on first start only; change it later in the UI).
OPENVPN_ADMIN_USERNAME=admin
# Leave empty to have a random password generated and printed in the UI logs
# (docker compose logs openvpn-ui).
OPENVPN_ADMIN_PASSWORD=

# Public address of this server, written into every client profile as the
# "remote" line. Can also be changed later in Settings.
#
# This is the address clients dial, which is not always the one OpenVPN binds:
# with a router or relay forwarding a port, the two differ. The protocol is
# not configurable here - a forward can remap a port but never turn UDP into
# TCP, so it always follows "proto" in server.conf.
OVPN_PUBLIC_HOST=vpn.example.com
# Leave empty to use the "port" from server.conf; set it only when a different
# public port is forwarded to that one.
OVPN_PUBLIC_PORT=

# Set to "true" when the UI is served through an HTTPS reverse proxy.
OVPN_UI_SECURE_COOKIES=auto

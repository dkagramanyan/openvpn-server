# Copy to .env and adjust. Never commit .env.

# Web UI admin account (created on first start only; change it later in the UI).
# Empty password = a random one, printed once in `docker compose logs openvpn-ui`.
OPENVPN_ADMIN_USERNAME=admin
OPENVPN_ADMIN_PASSWORD=

# Public host written into every client profile ("remote" lines); also
# editable under Settings, together with a public port per protocol. The
# protocols and default ports follow the "local" lines in server.conf.
OVPN_PUBLIC_HOST=vpn.example.com

# Public base URL of the one-time profile links (Share link), e.g.
# https://vpn.example.com - a reverse proxy must forward the path /p/ to the UI.
# Empty = the address the admin UI was opened with.
OVPN_PROFILE_BASE_URL=

# The daily backup archives hold the CA key. With an age public key here they
# are encrypted to it, and only the private key - which you keep somewhere
# else - opens them:  age-keygen -o backup-key.txt   (prints "Public key: age1...")
OVPN_BACKUP_RECIPIENT=

# Web UI: "true" behind an HTTPS reverse proxy; listen address (port 8080);
# proxies whose X-Forwarded-For header is believed (comma separated).
OVPN_UI_SECURE_COOKIES=auto
OVPN_UI_BIND=0.0.0.0
OVPN_UI_TRUSTED_PROXIES=127.0.0.1,170.134.51.13

# Apple Network Relay starts with the other services: docker compose up -d --build
# Configure public URL, internet/LAN routing and LAN CIDRs in the UI Settings.
# Default: Traefik keeps the certificate and sends cleartext HTTP/2 over the LAN.
APPLE_RELAY_TRANSPORT=http2
APPLE_RELAY_HTTP2_BIND=:8444
# The Raspberry Pi's source IP in existing proxy logs; adjust to your Traefik host.
APPLE_RELAY_TRUSTED_PROXIES="127.0.0.1/32 ::1/128 170.134.51.13/32"
# Only needed with APPLE_RELAY_TRANSPORT=http3 (direct QUIC, UDP 8443).
# This directory then needs fullchain.pem and privkey.pem readable by UID 65532.
APPLE_RELAY_TLS_DIR=./relay-tls
APPLE_RELAY_BIND=:8443
# Independent evaluator; keep this on the relay host loopback.
APPLE_RELAY_AUTH_URL=http://127.0.0.1:8447/api/relay/authorize
# Shared flow budgets. A client's devices share its per-client limit.
APPLE_RELAY_MAX_FLOWS=256
APPLE_RELAY_MAX_FLOWS_PER_CLIENT=64
APPLE_RELAY_MAX_AUTH_CHECKS=64
APPLE_RELAY_MAX_H2_CONNECTIONS=128
APPLE_RELAY_MAX_H2_STREAMS=256
# Abandoned network paths are detected using HTTP/2 PINGs.
APPLE_RELAY_H2_READ_IDLE=10s
APPLE_RELAY_H2_PING_TIMEOUT=5s

# Automatic signed downloads: enable profile-signing in the Pi deployment:
# https://github.com/dkagramanyan/traefik#automatic-profile-signing
# Set this URL and the SAME random token on both machines.
# Generate the token with: openssl rand -hex 32
OVPN_RELAY_SIGNER_URL=
# OVPN_RELAY_SIGNER_URL=https://openvpn.dgkagramanyan.ru/internal/relay-sign
RELAY_PROFILE_SIGNING_TOKEN=

# PostgreSQL runtime storage. Generate missing secrets with: python3 bin/setup-env.py
# Existing SQLite state is imported once by bin/upgrade-relay.sh; its file is retained.
OPENVPN_DB_PORT=5433
POSTGRES_PASSWORD=
OPENVPN_DB_PASSWORD=
RELAY_POLICY_DB_PASSWORD=

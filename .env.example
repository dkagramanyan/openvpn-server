# Copy to .env and adjust. Never commit .env.

# Web UI admin account (created on first start only; change it later in the UI).
# Empty password = a random one, printed once in `docker compose logs openvpn-ui`.
OPENVPN_ADMIN_USERNAME=admin
OPENVPN_ADMIN_PASSWORD=

# Public host written into every client profile ("remote" lines); also
# editable under Settings, together with a public port per protocol. The
# protocols and default ports follow the "local" lines in server.conf.
OVPN_PUBLIC_HOST=vpn.example.com

# Public base URL of the one-time profile links (Share link), e.g.
# https://vpn.example.com - a reverse proxy must forward the path /p/ to the UI.
# Empty = https://<website hostname> from Settings → Network.
OVPN_PROFILE_BASE_URL=

# Telegram bot (token from @BotFather): clients get their profile links and
# portal password from it. Empty = no bot.
OVPN_TELEGRAM_BOT_TOKEN=

# Xray through 3x-ui (service xui): panel port and the address it listens on. The gateway
# serves the panel at https://<OpenVPN hostname>/<panel path>/ to trusted networks;
# 127.0.0.1 keeps it on this server only (reach it with ssh -L 2053:127.0.0.1:2053).
XUI_PORT=2053
XUI_LISTEN=0.0.0.0

# The daily backup archives hold the CA key. With an age public key here they
# are encrypted to it, and only the private key - which you keep somewhere
# else - opens them:  age-keygen -o backup-key.txt   (prints "Public key: age1...")
OVPN_BACKUP_RECIPIENT=

# Web UI: "true" behind an HTTPS reverse proxy; listen address (port 8080);
# proxies whose X-Forwarded-For header is believed (comma separated).
OVPN_UI_SECURE_COOKIES=auto
OVPN_UI_BIND=0.0.0.0
OVPN_UI_TRUSTED_PROXIES=127.0.0.1

# Apple Network Relay starts with the other services: docker compose up -d --build
# Its public URL and on/off switch are in Settings → Network.
# HTTP/2: Traefik keeps the certificate and sends cleartext HTTP/2 over the LAN.
# HTTP/3: direct QUIC on UDP 8443 of this server; it starts by itself once
# APPLE_RELAY_TLS_DIR holds fullchain.pem and privkey.pem readable by UID 65532
# (bin/export-relay-cert.py), and a renewed pair is picked up without a restart.
# http2+http3 serves both; http2 or http3 alone are still accepted.
APPLE_RELAY_TRANSPORT=http2+http3
APPLE_RELAY_HTTP2_BIND=:8444
# Bootstrap proxy trust; use Settings → Network after startup.
APPLE_RELAY_TRUSTED_PROXIES="127.0.0.1/32 ::1/128"
APPLE_RELAY_TLS_DIR=./relay-tls
# HTTP/2 straight from the devices over TLS on this TCP address; off = only through the gateway
APPLE_RELAY_HTTP2_TLS_BIND=:8443
# The relay's certificate, renewed by the relay-cert service (lego, DNS-01), as Traefik does on the gateway.
# The same values as in the gateway's .env; empty RELAY_CERT_DOMAIN = off (copy the files in by hand).
RELAY_CERT_DOMAIN=
ACME_EMAIL=
ACME_DNS_PROVIDER=selectelv2
# How long the TXT record stands before Let's Encrypt checks it (longer than its TTL)
ACME_DNS_WAIT=120s
SELECTELV2_ACCOUNT_ID=
SELECTELV2_PROJECT_ID=
SELECTELV2_USERNAME=
SELECTELV2_PASSWORD=
APPLE_RELAY_BIND=:8443
# Independent evaluator; keep this on the relay host loopback.
APPLE_RELAY_AUTH_URL=http://127.0.0.1:8447/api/relay/authorize
# Shared flow budgets. A client's devices share its per-client limit.
APPLE_RELAY_MAX_FLOWS=2048
APPLE_RELAY_MAX_FLOWS_PER_CLIENT=512
APPLE_RELAY_MAX_AUTH_CHECKS=64
APPLE_RELAY_MAX_H2_CONNECTIONS=128
APPLE_RELAY_MAX_H2_STREAMS=512
# Networks that take TCP but drop UDP (the router's FakeIP range); "off" = none
APPLE_RELAY_UDP_REFUSED=198.18.0.0/15
# Abandoned network paths are detected using HTTP/2 PINGs.
APPLE_RELAY_H2_READ_IDLE=10s
APPLE_RELAY_H2_PING_TIMEOUT=5s

# Network, gateway and guest portal settings live in Settings → Network, not here.

# Automatic signed downloads: enable profile-signing in the gateway deployment:
# https://github.com/dkagramanyan/traefik#automatic-profile-signing
# Set this URL and the SAME random token on both machines.
# Generate the token with: openssl rand -hex 32
OVPN_RELAY_REQUIRE_SIGNED=true
OVPN_RELAY_SIGNER_URL=
# OVPN_RELAY_SIGNER_URL=https://openvpn.example.com/internal/relay-sign
RELAY_PROFILE_SIGNING_TOKEN=

# PostgreSQL runtime storage. Generate missing secrets with: python3 bin/setup-env.py
# Existing SQLite state is imported once by bin/upgrade-relay.sh; its file is retained.
OPENVPN_DB_PORT=5433
POSTGRES_PASSWORD=
OPENVPN_DB_PASSWORD=
RELAY_POLICY_DB_PASSWORD=
